<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tyria_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/label_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textColor="#E8CF93"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/next_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F6F1E8"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/next_map"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B9AA8C"
        android:textSize="12sp" />

    <Chronometer
        android:id="@+id/next_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F6F1E8"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B9AA8C"
                android:textSize="11sp" />

            <Chronometer
                android:id="@+id/daily_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8CF93"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_weekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B9AA8C"
                android:textSize="11sp" />

            <Chronometer
                android:id="@+id/weekly_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8CF93"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/later"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B9AA8C"
        android:textSize="11sp" />
</LinearLayout>
