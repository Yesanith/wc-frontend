<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tyria_widget_bg"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/label_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#E8CF93"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- the next event on the left, its countdown on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/next_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F6F1E8"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/next_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B9AA8C"
                android:textSize="12sp" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/next_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="#F6F1E8"
            android:textSize="26sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="7dp"
        android:layout_marginTop="7dp"
        android:background="#4A3C27" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B9AA8C"
                android:textSize="11sp" />

            <Chronometer
                android:id="@+id/daily_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8CF93"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_weekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B9AA8C"
                android:textSize="11sp" />

            <Chronometer
                android:id="@+id/weekly_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8CF93"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- the two events after the first, each on a line of its own -->
    <LinearLayout
        android:id="@+id/later_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/later_1_time"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#E8CF93"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/later_1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F6F1E8"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/later_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/later_2_time"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#E8CF93"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/later_2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F6F1E8"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
